{
  "name": "math-homework",
  "version": "1.0.0",
  "private": true,
  "description": "A local camera-first math homework review app",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "VITE_DEV_SERVER_URL=http://localhost:5173 concurrently -k \"npm:dev:electron\" \"vite\" \"wait-on http://localhost:5173 dist-electron/main.js && electron .\"",
    "dev:electron": "npm run build:electron -- --watch",
    "typecheck": "tsc --noEmit",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --packages=external --external:electron --outdir=dist-electron --sourcemap",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "start": "electron .",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.25.0",
    "mathjs": "^15.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "write-file-atomic": "^7.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/write-file-atomic": "^4.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^6.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
